{
  "name": "revealtex-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b --pretty false",
    "build:web": "npm run build --workspace @revealtex/studio-web",
    "studio": "node packages/cli/dist/cli.js studio --web apps/studio-web/dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
