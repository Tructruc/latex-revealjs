\begin{subframe}{The objective}
\[\mathcal{L} = -\sum_i y_i \log \hat{y}_i\]
\begin{block}{Cross-entropy}
The negative log-likelihood of the target class.
\end{block}
\callout[info]{Vertical slides keep related detail on \textcolor{#a5b4fc}{one navigation branch}.}
\badge{Framework-neutral IR}
\end{subframe}
