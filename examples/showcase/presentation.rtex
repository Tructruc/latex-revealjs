\begin{frame}{Code is content}
\begin{code}[language=typescript,numbers=true,highlight={2}]
const deck = compile(source)
await renderer.render(deck)
\end{code}
The compiler preserves the source model.
\pause
The renderer adds framework-specific behavior only at the edge.
\end{frame}
\begin{frame}[state=overlays,transition=fade]{Beamer-style overlays}
\begin{itemize}
\item<1-> Always visible from the first overlay
\item<2-> Appears on the second overlay
\item<3-> Appears on the third overlay
\end{itemize}
\only<4>{This content only exists on the fourth step.}
\uncover<5->{This is uncovered from the fifth step onward.}
\alt<6>{Shown before overlay six}{Shown from overlay six}
\end{frame}
\begin{frame}{Step-by-step derivations}
\begin{steps}
\[ f(x)=x^2 \]
\[ f'(x)=2x \]
\[ f'(3)=6 \]
\end{steps}
\begin{align}
\mathcal{L} &= \sum_i (y_i - \hat{y}_i)^2 \\
\hat{y}_i &= \sigma(w^T x_i + b)
\end{align}
\end{frame}
